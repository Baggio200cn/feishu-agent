{
  "_comment": "复制此文件为 credentials.json 并填写真实配置。在 https://open.feishu.cn/app 创建自建应用获取凭证。",
  "accounts": {
    "personal": {
      "_comment": "个人飞书账号的自建应用凭证。需要权限：wiki:wiki:write, docx:document:write, mail:mail:read, im:message, calendar:calendar",
      "app_id": "cli_personal_app_id_here",
      "app_secret": "personal_app_secret_here",
      "wiki_space_id": "your_personal_wiki_space_id"
    },
    "enterprise": {
      "_comment": "企业飞书账号的自建应用凭证（需企业管理员审批）。需要权限：wiki:wiki:read, docx:document:read, drive:drive:readonly",
      "app_id": "cli_enterprise_app_id_here",
      "app_secret": "enterprise_app_secret_here"
    }
  },
  "ai": {
    "_comment": "豆包 AI 用于文档自动分类。在火山方舟控制台 https://console.volcengine.com/ark 获取 API Key",
    "provider": "doubao",
    "api_key": "your_doubao_api_key_here",
    "model": "doubao-seed-2-0-mini-260215",
    "base_url": "https://ark.cn-beijing.volces.com/api/v3"
  },
  "github": {
    "_comment": "GitHub Trending 日报配置。Token 在 https://github.com/settings/tokens 创建（勾 public_repo）",
    "token": "ghp_your_github_token_here",
    "trending": {
      "_comment": "新流程：从 /trending 抓热门 + 豆包 AI 中文摘要 + 飞书日报页。period: daily/weekly/monthly；language 留空=全部",
      "enabled": true,
      "period": "daily",
      "language": "",
      "limit": 10
    },
    "parent_folder": "github专区",
    "repo_list": [],
    "search_topics": []
  },
  "reddit": {
    "_comment": "Reddit AI 日报配置。Reddit 在中国大陆需 VPN 才能访问；代码会自动识别 HTTP_PROXY / HTTPS_PROXY 环境变量",
    "enabled": true,
    "subreddits": [
      "MachineLearning",
      "LocalLLaMA",
      "ClaudeAI",
      "LLMDevs"
    ],
    "period": "day",
    "per_sub_fetch": 10,
    "limit_total": 10,
    "top_comments": 6,
    "parent_folder": "reddit专区",
    "user_agent": "feishu-agent/0.1"
  },
  "laoba_feng": {
    "_comment": "老巴疯啦 — 灵感发散流水线。每天扫 8 个垂直 subreddit + GitHub trending（白名单关键词），用老巴人设做五维度头脑风暴。北极星 A=货代 BD agent，北极星 B=B1/B2/B7（生活即内容/平行人生/孤独消除）。",
    "enabled": true,
    "subreddits": [
      "Webscraping",
      "DataHoarder",
      "FulfillmentByAmazon",
      "dropshipping",
      "coldemail",
      "sales",
      "LocalLLaMA"
    ],
    "per_sub_fetch": 5,
    "limit_total": 12,
    "top_comments": 3,
    "github_keyword_whitelist": [
      "scraper", "crawler", "lead", "intent", "b2b",
      "clearbit", "apollo", "outreach", "enrichment",
      "prospecting", "crm", "linkedin", "whois",
      "shipping", "customs"
    ],
    "github_limit": 5,
    "parent_folder": "老巴疯啦",
    "persona": "老巴 = 50 岁是幽默（实际接近退休的体制内闲职），对 AI 极度风靡（痴迷到老婆嫌烦），说话带东北味儿、爱讲段子、判断犀利但不咬文嚼字，看潮流是老司机看小年轻——激情但不端着。"
  },
  "schedule": {
    "_comment": "定时任务配置。每个任务的 type 必须是 github / reddit / organize / laoba_feng 之一。时间为本地（Asia/Shanghai）24 小时制。",
    "jobs": [
      {"type": "github", "hour": 9, "minute": 0, "enabled": true},
      {"type": "reddit", "hour": 9, "minute": 0, "enabled": true},
      {"type": "laoba_feng", "hour": 9, "minute": 30, "enabled": true},
      {"type": "organize", "hour": 23, "minute": 0, "enabled": true}
    ]
  }
}
